{
  "name": "dd-chords-pwa",
  "version": "0.0.9",
  "scripts": {
    "ng": "ng",
    "generate-chords-index": "node generate-chords-index",
    "start": "node server.js",
    "prebuild": "rimraf dist && pnpm run generate-chords-index",
    "build": "ng build --configuration production",
    "prebuild:dev": "pnpm run prebuild",
    "build:dev": "ng build",
    "build:watch": "ng build --watch",
    "test": "jest --ci --logHeapUsage",
    "test:dev": "jest --updateSnapshot --bail --runInBand",
    "test:watch": "jest --updateSnapshot --bail --runInBand --watchAll",
    "test:coverage": "jest --coverage",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "rxjs": "^7.8.1",
    "ts-md5": "^1.2.7",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^9.18.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/web-bluetooth": "^0.0.20",
    "angular-eslint": "22.6.0",
    "eslint": "^9.18.0",
    "express": "^4.17.1",
    "https": "^1.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "^17.0.3",
    "jsdom": "^26.1.0",
    "ng-mocks": "^14.18.5",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "rimraf": "^5.0.10",
    "ts-mockery": "^1.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
